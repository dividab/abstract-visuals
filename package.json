{
  "private": true,
  "repository": "https://github.com/dividab/abstract-visuals",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "precommit": "lint-staged",
    "publish-npm": "scripts/publish-npm.sh",
    "verify": "run-s lint build typecheck:tests test",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test:abstract-3d": "vitest run --dir packages/abstract-3d",
    "bench:abstract-3d": "vitest bench --run --dir packages/abstract-3d --reporter=verbose",
    "bench:abstract-3d:browser": "node packages/abstract-3d/bench/browser/run.ts",
    "bench:abstract-3d:windows": "node packages/abstract-3d/bench/browser/windows.ts",
    "bench:abstract-3d:svg": "node packages/abstract-3d/bench/svg.ts",
    "test:abstract-image": "vitest run --dir packages/abstract-image --silent=false",
    "test:abstract-document": "vitest run --dir packages/abstract-document",
    "lint": "oxlint --type-aware -c ./oxlint.config.js ./packages",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "tsc -b packages --clean && rm -rf packages/*/lib",
    "cleanbuild": "run-s clean build",
    "build": "tsc -b packages",
    "update-refs": "node --experimental-strip-types scripts/update-refs.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck:tests": "tsc -p packages/abstract-3d/tsconfig.test.json && tsc -p packages/abstract-3d/bench/tsconfig.json && tsc -p packages/jsxpression/tsconfig.test.json",
    "build-watch": "tsc -b -w --preserveWatchOutput packages",
    "start": "cd packages/abstract-visuals-example && vite",
    "storybook": "start-storybook -p 6006 --ci",
    "build-storybook": "build-storybook",
    "gen": "xsd-ts ./packages/abstract-document/src/abstract-document-xml/xsd.xml ./packages/abstract-document/src/abstract-document-xml/abstract-document.ts",
    "clean-node-modules": "rm -rf node_modules && rm -rf ./packages/*/node_modules",
    "prod": "vite build packages/abstract-visuals-example --config packages/abstract-visuals-example/vite.config.ts",
    "analyze": "ANALYZE=1 vite build packages/abstract-visuals-example --config packages/abstract-visuals-example/vite.config.ts"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.1.1",
    "@storybook/addon-links": "^8.1.1",
    "@storybook/react": "^8.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "@xsd-tools/typescript": "^0.2.0",
    "husky": "^0.14.3",
    "lerna": "^10.0.1",
    "lint-staged": "^10.5.4",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-config-divid": "^1.5.5",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "catalog:",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-next": "npm:typescript@7.0.2",
    "vite": "catalog:",
    "vite-plugin-node-polyfills": "catalog:",
    "vitest": "catalog:",
    "xmldom": "^0.6.0",
    "xsd-tools": "^0.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --type-aware -c ./oxlint.config.js",
    "*.{ts,tsx,js,json,css,md}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
