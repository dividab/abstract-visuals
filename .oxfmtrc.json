{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 150,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortPackageJson": true,
  "sortImports": { "newlinesBetween": false },
  "jsdoc": true,
  "ignorePatterns": ["packages/*/public/**", "*.html", "stats.html"]
}
